<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="FareSearchService"
    targetNamespace="http://example.com/fare/service/"
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:reply="http://xml.amadeus.com/FMPTBR_20_2_1A"
    xmlns:tns="http://example.com/fare/service/">

    <wsdl:types>
        <xs:schema targetNamespace="http://example.com/fare/service/" elementFormDefault="qualified"
            attributeFormDefault="unqualified">
            <xs:import namespace="http://xml.amadeus.com/FMPTBR_20_2_1A"
                schemaLocation="fare-search.xsd" />
            <xs:complexType name="TravellerDetailsType">
                <xs:sequence>
                    <xs:element name="ref" minOccurs="0" type="xs:int" />
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="PaxReferenceType">
                <xs:sequence>
                    <xs:element name="ptc" minOccurs="0" maxOccurs="4" type="xs:string" />
                    <xs:element name="traveller" minOccurs="0" maxOccurs="9"
                        type="tns:TravellerDetailsType" />
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="PaxFareProductType">
                <xs:sequence>
                    <xs:element name="paxReference" minOccurs="0" maxOccurs="6"
                        type="tns:PaxReferenceType" />
                </xs:sequence>
            </xs:complexType>

            <xs:complexType name="RecommendationType">
                <xs:sequence>
                    <xs:element name="paxFareProduct" maxOccurs="10"
                        type="tns:PaxFareProductType" />
                </xs:sequence>
            </xs:complexType>

            <xs:element name="FareBoardSearchOperationRequest">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="origin" type="xs:string" />
                        <xs:element name="destination" type="xs:string" />
                        <xs:element name="paxFareProduct" maxOccurs="10"
                            type="tns:PaxFareProductType" />
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

        </xs:schema>
    </wsdl:types>

    <wsdl:message name="FareSearchRequest">
        <wsdl:part name="parameters" element="tns:FareBoardSearchOperationRequest" />
    </wsdl:message>
    <wsdl:message name="FareSearchReplyMsg">
        <wsdl:part name="parameters" element="reply:FareSearchReply" />
    </wsdl:message>

    <wsdl:portType name="FareSearchPortType">
        <wsdl:operation name="FareBoardSearchOperation">
            <wsdl:input message="tns:FareSearchRequest" />
            <wsdl:output message="tns:FareSearchReplyMsg" />
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="FareSearchBinding"
        type="tns:FareSearchPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http" />
        <wsdl:operation name="FareBoardSearchOperation">
            <soap:operation
                soapAction="http://example.com/fare/service/FareBoardSearchOperation"
                style="document" />
            <wsdl:input>
                <soap:body use="literal" />
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal" />
            </wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="FareSearchService">
        <wsdl:port name="FareSearchPort"
            binding="tns:FareSearchBinding">
            <soap:address location="http://localhost:8000/service" />
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>